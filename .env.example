# Optional settings. Export them in the shell before starting the API.
# .env files are not loaded automatically. Never commit your real secrets.
# CLASSLENS_DATA_DIR=/absolute/private/path/to/data
# CLASSLENS_MODEL_DIR=/absolute/private/path/to/models
# CLASSLENS_SECRET=generate-a-long-random-secret-outside-this-file
CLASSLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
