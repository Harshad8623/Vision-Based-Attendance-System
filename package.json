{
  "name": "classlens",
  "version": "0.1.0",
  "private": true,
  "description": "A thoughtful classroom attendance workspace by Harshad Madhav Dhuppe",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests/e2e/*.ts *.ts *.json *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check src tests/e2e/*.ts *.ts *.json *.yaml .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.8.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
